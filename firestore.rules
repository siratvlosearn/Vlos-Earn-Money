rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'sirattuba.official@gmail.com'
      );
    }

    // Users Collection: Users can read their own profile.
    // Balance and coin updates are forbidden from client SDK and must come through server.
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      // User can only update profile fields (name, phone, profilePhoto), never coins or balances
      allow update: if (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'coins', 'balanceUsd', 'todayEarnings', 'totalEarnings',
          'referralEarnings', 'availableWithdrawalBalance', 'pendingWithdrawal',
          'status', 'referralCode'
        ])
      ) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Tasks Collection: Any user can read active tasks. Only admins can write.
    match /tasks/{taskId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Task Completions: Only created after server verification, or read by owner / admin
    match /taskCompletions/{completionId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Video Ads Collection: Any user can read active ads. Only admins can write.
    match /ads/{adId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Transactions: Users can only read their own transactions. Only server/admin can write.
    match /transactions/{transactionId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Withdrawal Requests: Users can read their own requests.
    match /withdrawals/{withdrawalId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Currencies: Public read. Only admin can modify.
    match /currencies/{currencyId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Withdrawal Methods: Public read. Only admin can modify.
    match /withdrawalMethods/{methodId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Notices: Public read active notices. Only admin can write.
    match /notices/{noticeId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Platform Settings: Public read. Only admin can write.
    match /adminSettings/{settingId} {
      allow get: if true;
      allow create, update, delete: if isAdmin();
    }

    // Admin Audit Logs: Admin read/write only.
    match /adminAuditLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
